<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  <Id>933898cb-08f9-4343-a348-29278bafbf0f</Id>
  <Version>1.0.0.2</Version>
  <ProviderName>Dana POC</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Dana Outlook DEV" />
  <Description DefaultValue="Dana Outlook DEV technical test harness for AI drafting, native replies, and delayed delivery." />
  <IconUrl DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/" />
  <AppDomains><AppDomain>https://alphabravo333charlie-cell.github.io</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.1" /></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/taskpane-dev.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.13"><bt:Set Name="Mailbox" /></bt:Sets></Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="Dana.Dev.Group">
                <Label resid="Dana.Dev.GroupLabel" />
                <Control xsi:type="Button" id="Dana.Dev.Button">
                  <Label resid="Dana.Dev.ButtonLabel" />
                  <Supertip><Title resid="Dana.Dev.ButtonLabel" /><Description resid="Dana.Dev.Description" /></Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Dana.Dev.Taskpane.Url" /></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="Dana.Dev.Compose.Group">
                <Label resid="Dana.Dev.Compose.GroupLabel" />
                <Control xsi:type="Button" id="Dana.Dev.Compose.Button">
                  <Label resid="Dana.Dev.Compose.ButtonLabel" />
                  <Supertip><Title resid="Dana.Dev.Compose.ButtonLabel" /><Description resid="Dana.Dev.Compose.Description" /></Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Dana.Dev.Taskpane.Url" /></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/commands.html" />
        <bt:Url id="Dana.Dev.Taskpane.Url" DefaultValue="https://alphabravo333charlie-cell.github.io/dana-outlook-addin-staging/taskpane-dev.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Dana.Dev.GroupLabel" DefaultValue="Dana DEV" />
        <bt:String id="Dana.Dev.ButtonLabel" DefaultValue="Dana DEV" />
        <bt:String id="Dana.Dev.Compose.GroupLabel" DefaultValue="Dana DEV" />
        <bt:String id="Dana.Dev.Compose.ButtonLabel" DefaultValue="Send in 2 minutes" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Dana.Dev.Description" DefaultValue="Open the Dana development task pane." />
        <bt:String id="Dana.Dev.Compose.Description" DefaultValue="Open Dana DEV for the reviewed compose message." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

